GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.1-flash-lite
# Currency conversion for the fixed-package marketplace benchmarks.
CURRENCY_RATES_PER_USD=USD:1,EGP:48.5,EUR:0.92,GBP:0.79
GEMINI_PLAN_MAX_OUTPUT_TOKENS=32768
GEMINI_PLAN_TIMEOUT_MS=300000
GEMINI_PLAN_THINKING_BUDGET=0
GEMINI_REQUIREMENTS_MODEL=
GEMINI_REQUIREMENTS_FALLBACK_MODELS=
GEMINI_REQUIREMENTS_MAX_OUTPUT_TOKENS=2048
GEMINI_REQUIREMENTS_DOCUMENT_MAX_OUTPUT_TOKENS=2048
# Prefer a model-supported level such as low/medium/high. Leave empty to use
# the model default; a positive legacy budget remains supported as fallback.
GEMINI_REQUIREMENTS_THINKING_LEVEL=
GEMINI_REQUIREMENTS_THINKING_BUDGET=0
GEMINI_THINKING_BUDGET=0
REQUIREMENTS_FAST_PATH_ENABLED=false
FIGMA_ACCESS_TOKEN=
GITHUB_API_URL=https://api.github.com
FIGMA_SMOKE_FILE_URL=
